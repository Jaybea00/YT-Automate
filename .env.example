# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to true to bypass ffmpeg startup verification if system ffmpeg is not yet installed
SKIP_FFMPEG_CHECK=true

# Optional AI / Media Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
NASA_API_KEY=
# Real sound effects the narration describes (CC0 sounds only): free key at freesound.org/apiv2/apply
FREESOUND_API_KEY=
# ai33.pro (OpenSpeaker) voices: API key from https://ai33.pro/app/api-document
AI33_API_KEY=
# Video encoder: auto (graphics chip for joins when available) | software | hardware
VIDEO_ENCODER=auto
# Final master on the graphics chip too (faster, very slightly lower quality): software | hardware
VIDEO_ENCODER_MASTER=software
